# Database
DATABASE_URL=postgresql+psycopg://cib_user:cib_pass@localhost:5432/cib_detection

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# YouTube Data API v3 (obtain from Google Cloud Console)
# Only needed if USE_SAMPLE_DATA=false, which makes the tool collect real
# comments. The model scoring them is synthetic either way.
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Model artifact (joblib serialized Isolation Forest)
MODEL_PATH=app/ml/artifacts/isolation_forest_hybrid.joblib
SCALER_PATH=app/ml/artifacts/standard_scaler.joblib

# MLflow tracking (optional - file-based default)
MLFLOW_TRACKING_URI=file:./mlruns

# Anomaly detection settings (matches thesis: contamination=0.05, random_state=42)
CONTAMINATION=0.05
RANDOM_STATE=42

# Co-commenter graph edge threshold (thesis: minimum of two co-commented videos)
EDGE_MIN_COCOMMENTED_VIDEOS=2

# Temporal burst window in seconds (thesis: ten-minute window)
BURST_WINDOW_SECONDS=600

# Synthetic comments by default, so the demo needs no API key and no quota.
# Set false to collect real comments; the model remains synthetic.
USE_SAMPLE_DATA=true

# CORS for frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
